@model ErrorPageViewModel
@{
    Layout = null;
    var loggedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.StatusCode · @Model.Title · Mailora</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root { --ink: #303348; --muted: #85899B; --accent: #8B7FD6; --accent-dark: #6F62C6; --lav: #EFEDFB; --bg: #F7F6FC; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px;
               font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: var(--ink);
               background: radial-gradient(1000px 500px at 10% -10%, #ECE8FF 0%, transparent 60%),
                           radial-gradient(800px 500px at 110% 110%, #E3F4EC 0%, transparent 60%), var(--bg); }
        .card { width: 100%; max-width: 520px; background: #fff; border-radius: 28px; padding: 44px 40px 36px; text-align: center;
                box-shadow: 0 30px 80px -30px rgba(70, 60, 140, .25), 0 1px 0 rgba(0,0,0,.02); }
        .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 20px; color: var(--ink); text-decoration: none; margin-bottom: 28px; }
        .brand .logo { width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center; color: #fff;
                       background: linear-gradient(135deg, var(--accent), var(--accent-dark)); }
        .brand span span { color: var(--accent); }
        .code { font-size: 88px; line-height: 1; font-weight: 800; letter-spacing: -3px;
                background: linear-gradient(135deg, var(--accent), #E07597); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .ic { width: 64px; height: 64px; border-radius: 20px; display: grid; place-items: center; margin: 18px auto 14px;
              background: var(--lav); color: var(--accent-dark); font-size: 28px; }
        h1 { font-size: 22px; margin: 0 0 10px; }
        p { color: var(--muted); margin: 0 0 28px; line-height: 1.6; font-size: 15px; }
        .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 14px; font-weight: 700; font-size: 14px;
               text-decoration: none; border: 0; cursor: pointer; font-family: inherit; }
        .btn.primary { background: linear-gradient(135deg, var(--accent), var(--accent-dark)); color: #fff; box-shadow: 0 10px 24px -10px var(--accent); }
        .btn.ghost { background: var(--lav); color: var(--accent-dark); }
    </style>
</head>
<body>
    <main class="card">
        <a class="brand" asp-controller="Dashboard" asp-action="Index">
            <span class="logo"><i class="bi bi-envelope-paper-heart-fill"></i></span>
            <span>Mail<span>ora</span></span>
        </a>
        <div class="code">@Model.StatusCode</div>
        <div class="ic"><i class="bi @Model.Icon"></i></div>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
        <div class="actions">
            @if (loggedIn)
            {
                <a class="btn primary" asp-controller="Message" asp-action="Inbox"><i class="bi bi-inbox"></i> Gelen Kutusuna Dön</a>
                <a class="btn ghost" href="javascript:history.back()"><i class="bi bi-arrow-left"></i> Geri</a>
            }
            else
            {
                <a class="btn primary" asp-controller="Login" asp-action="SignIn"><i class="bi bi-box-arrow-in-right"></i> Giriş Yap</a>
                <a class="btn ghost" asp-controller="Register" asp-action="SignUp"><i class="bi bi-person-plus"></i> Kayıt Ol</a>
            }
        </div>
    </main>
</body>
</html>
