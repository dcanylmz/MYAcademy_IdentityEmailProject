@model SidebarViewModel
<!-- =====================================================================
      SHARED SIDEBAR — menü rozetleri ve kategoriler veritabanından gelir
      ===================================================================== -->
<aside class="app-sidebar" id="appSidebar" aria-label="Ana menü">
    <a class="brand" data-page="dashboard" asp-controller="Dashboard" asp-action="Index" style="text-decoration:none">
        <div class="brand-logo"><i class="bi bi-envelope-paper-heart-fill"></i></div>
        <div class="brand-name">Mail<span>ora</span></div>
    </a>

    <a class="btn-compose" data-page="compose" asp-controller="Message" asp-action="CreateMessage" data-tip="Yeni Mesaj">
        <i class="bi bi-pencil-square"></i> <span class="lbl">Yeni Mesaj</span>
    </a>

    <div class="nav-section-title">Menü</div>
    <ul class="side-nav">
        <li><a class="side-link" data-page="dashboard" asp-controller="Dashboard" asp-action="Index" data-tip="Dashboard"><i class="bi bi-grid-1x2"></i> <span class="lbl">Dashboard</span></a></li>
        <li><a class="side-link" data-page="inbox" asp-controller="Message" asp-action="Inbox" data-tip="Gelen Kutusu"><i class="bi bi-inbox"></i> <span class="lbl">Gelen Kutusu</span> <span class="side-badge" id="badgeInbox">@(Model.InboxUnread > 0 ? Model.InboxUnread.ToString() : "")</span></a></li>
        <li><a class="side-link" data-page="sent" asp-controller="Message" asp-action="Sendbox" data-tip="Gönderilenler"><i class="bi bi-send"></i> <span class="lbl">Gönderilenler</span></a></li>
        <li><a class="side-link" data-page="drafts" asp-controller="Message" asp-action="Drafts" data-tip="Taslaklar"><i class="bi bi-file-earmark-text"></i> <span class="lbl">Taslaklar</span> <span class="side-badge muted">@(Model.Drafts > 0 ? Model.Drafts.ToString() : "")</span></a></li>
        <li><a class="side-link" data-page="starred" asp-controller="Message" asp-action="Starred" data-tip="Yıldızlı Mesajlar"><i class="bi bi-star"></i> <span class="lbl">Yıldızlı Mesajlar</span> <span class="side-badge muted" id="badgeStarred">@(Model.Starred > 0 ? Model.Starred.ToString() : "")</span></a></li>
        <li><a class="side-link" data-page="trash" asp-controller="Message" asp-action="Trash" data-tip="Çöp Kutusu"><i class="bi bi-trash3"></i> <span class="lbl">Çöp Kutusu</span> <span class="side-badge muted" id="badgeTrash">@(Model.Trash > 0 ? Model.Trash.ToString() : "")</span></a></li>
    </ul>

    <div class="nav-section-title">Hesap</div>
    <ul class="side-nav">
        <li><a class="side-link" data-page="profile" asp-controller="Profile" asp-action="Index" data-tip="Profilim"><i class="bi bi-person-circle"></i> <span class="lbl">Profilim</span></a></li>
        <li><a class="side-link" data-page="settings" asp-controller="Profile" asp-action="Index" asp-fragment="security" data-tip="Güvenlik"><i class="bi bi-shield-lock"></i> <span class="lbl">Güvenlik</span></a></li>
    </ul>

    <div class="nav-section-title">Kategoriler</div>
    <ul class="side-labels">
        @foreach (var c in Model.Categories)
        {
            <li><a data-label="@c.CategoryName" data-tip="@c.CategoryName" href="#"><span class="dot" style="background:@c.CategoryColor"></span> <span class="lbl">@c.CategoryName</span></a></li>
        }
    </ul>

    <div class="storage-card" data-tip="Toplam @Model.TotalMessages mesaj">
        <div class="top">
            <div class="ic"><i class="bi bi-envelope-paper"></i></div>
            <div>
                <div class="t1">Mesajlarınız</div>
                <div class="t2">@Model.TotalMessages mesaj · @Model.InboxUnread okunmamış</div>
            </div>
        </div>
    </div>
</aside>
<div class="sidebar-backdrop" id="sidebarBackdrop"></div>
<!-- /SHARED SIDEBAR -->
