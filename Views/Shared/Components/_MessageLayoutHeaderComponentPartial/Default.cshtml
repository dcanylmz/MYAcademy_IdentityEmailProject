@model HeaderViewModel
<!-- =====================================================================
        SHARED NAVBAR — oturum açan kullanıcının bilgileri Identity'den gelir
        ===================================================================== -->
<header class="app-navbar">
    <button class="nav-toggle" id="sidebarToggle" type="button" aria-label="Menüyü daralt / genişlet" title="Menüyü daralt"><i class="bi bi-list"></i></button>

    <div class="global-search">
        <i class="bi bi-search"></i>
        <input type="search" id="globalSearch" placeholder="Mesajlarda, kişilerde ara…" autocomplete="off">
        <span class="kbd">Ctrl K</span>
    </div>

    <div class="nav-actions">
        <a class="icon-btn hide-xs" asp-controller="Message" asp-action="CreateMessage" title="Yeni Mesaj" style="text-decoration:none"><i class="bi bi-pencil-square"></i></a>

        <div class="dropdown">
            <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Bildirimler">
                <i class="bi bi-bell"></i>@if (Model.UnreadCount > 0){<span class="pip"></span>}
            </button>
            <div class="dropdown-menu dropdown-menu-end notif-menu">
                <div class="d-flex justify-content-between align-items-center px-2 pt-1 pb-2">
                    <strong style="font-size:14px">Bildirimler</strong>
                    @if (Model.UnreadCount > 0)
                    {
                        <span class="tag tag-is">@Model.UnreadCount yeni</span>
                    }
                </div>
                @if (Model.Notifications.Any())
                {
                    foreach (var n in Model.Notifications)
                    {
                        <a class="notif-item" href="@n.Url">
                            @UiHelpers.Avatar(n.CounterpartName, n.CounterpartImage, n.CounterpartEmail, "sm")
                            <div style="min-width:0">
                                <div class="nt">@n.CounterpartName size mesaj gönderdi</div>
                                <div class="nd">@n.Subject · @UiHelpers.ShortTime(n.Date)</div>
                            </div>
                        </a>
                    }
                    <div class="px-2 pt-2"><a asp-controller="Message" asp-action="Inbox" asp-route-filter="unread" style="font-size:13px;font-weight:700;color:var(--accent-dark);text-decoration:none">Tüm okunmamışları gör <i class="bi bi-arrow-right"></i></a></div>
                }
                else
                {
                    <div class="notif-empty"><i class="bi bi-check2-circle"></i> Okunmamış mesajınız yok</div>
                }
            </div>
        </div>

        <div class="dropdown">
            <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                @UiHelpers.Avatar(Model.FullName, Model.ImageUrl, Model.Email, "sm", "av-user")
                <span class="meta">
                    <span class="name d-block">@Model.FullName</span>
                    <span class="role d-block">@@@Model.UserName</span>
                </span>
                <i class="bi bi-chevron-down"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li class="dd-head">
                    @UiHelpers.Avatar(Model.FullName, Model.ImageUrl, Model.Email, "", "av-user")
                    <div style="min-width:0">
                        <div style="font-weight:700">@Model.FullName</div>
                        <div style="font-size:12.5px;color:var(--muted)">@Model.Email</div>
                    </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> Profilim</a></li>
                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index" asp-fragment="security"><i class="bi bi-shield-lock"></i> Şifre Değiştir</a></li>
                <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form method="post" asp-controller="Login" asp-action="Logout" class="m-0">
                        <button type="submit" class="dropdown-item danger"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
<!-- /SHARED NAVBAR -->
