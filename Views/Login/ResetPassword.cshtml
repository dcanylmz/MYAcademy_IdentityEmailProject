@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Şifre Yenile";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var invalid = ViewData["InvalidLink"] as bool? == true;
}

@if (invalid)
{
    <div class="center-ic warn"><i class="bi bi-link-45deg"></i></div>
    <div class="form-head">
        <h1>Bağlantı geçersiz</h1>
        <p>Bu şifre yenileme bağlantısı daha önce kullanılmış, süresi dolmuş ya da hatalı olabilir. Güvenliğiniz için yeni bir bağlantı isteyin.</p>
    </div>
    <a class="btn-primary-x" asp-controller="Login" asp-action="ForgotPassword" style="text-decoration:none">
        <span class="lbl">Yeni Bağlantı İste</span><i class="bi bi-arrow-repeat"></i>
    </a>
    <div class="form-foot"><a asp-controller="Login" asp-action="SignIn">Giriş sayfasına dön</a></div>
}
else
{
    <div class="center-ic"><i class="bi bi-shield-lock"></i></div>
    <div class="form-head">
        <h1>Yeni şifre belirleyin</h1>
        <p><b>@Model.Email</b> hesabı için yeni bir şifre oluşturun.</p>
    </div>

    <partial name="_AuthErrors" />

    <form method="post" asp-controller="Login" asp-action="ResetPassword" data-loading="Kaydediliyor…" novalidate>
        <input type="hidden" asp-for="Email">
        <input type="hidden" asp-for="Token">

        <div class="field">
            <label for="newPassword">Yeni Şifre <span class="req">*</span></label>
            <div class="input-wrap">
                <i class="bi bi-lock lead"></i>
                <input class="a-input has-eye" id="newPassword" asp-for="NewPassword" type="password" placeholder="En az 8 karakter" autocomplete="new-password" autofocus>
                <button type="button" class="eye-btn" data-eye="newPassword" aria-label="Şifreyi göster"><i class="bi bi-eye"></i></button>
            </div>
            <div class="caps"><i class="bi bi-capslock"></i> Caps Lock açık</div>
            <div class="hint">En az 8 karakter; büyük harf, küçük harf, rakam ve özel karakter içermeli.</div>
        </div>

        <div class="field">
            <label for="confirmNewPassword">Yeni Şifre Tekrar <span class="req">*</span></label>
            <div class="input-wrap">
                <i class="bi bi-shield-lock lead"></i>
                <input class="a-input has-eye" id="confirmNewPassword" asp-for="ConfirmPassword" type="password" placeholder="Şifrenizi tekrar girin" autocomplete="new-password">
                <button type="button" class="eye-btn" data-eye="confirmNewPassword" aria-label="Şifreyi göster"><i class="bi bi-eye"></i></button>
            </div>
            <div class="caps"><i class="bi bi-capslock"></i> Caps Lock açık</div>
        </div>

        <button type="submit" class="btn-primary-x">
            <span class="lbl">Şifremi Güncelle</span><i class="bi bi-check2"></i>
        </button>
    </form>
}
