@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var sent = ViewData["Sent"] as bool? == true;
}

@if (sent)
{
    <div class="center-ic ok"><i class="bi bi-send-check"></i></div>
    <div class="form-head">
        <h1>Email'inizi kontrol edin</h1>
        <p>
            <b>@Model.Email</b> adresiyle kayıtlı bir hesap varsa şifre yenileme bağlantısı gönderildi.
            Bağlantı <b>30 dakika</b> geçerlidir ve yalnızca bir kez kullanılabilir.
        </p>
    </div>
    <a class="btn-primary-x" asp-controller="Login" asp-action="SignIn" style="text-decoration:none">
        <span class="lbl">Giriş Sayfasına Dön</span><i class="bi bi-arrow-right"></i>
    </a>
    <div class="form-foot">Email gelmedi mi? <a asp-controller="Login" asp-action="ForgotPassword">Tekrar deneyin</a></div>
}
else
{
    <div class="center-ic"><i class="bi bi-key"></i></div>
    <div class="form-head">
        <h1>Şifrenizi mi unuttunuz?</h1>
        <p>Hesabınıza kayıtlı email adresini girin, size şifre yenileme bağlantısı gönderelim.</p>
    </div>

    <partial name="_AuthErrors" />

    <form method="post" asp-controller="Login" asp-action="ForgotPassword" data-loading="Gönderiliyor…" novalidate>
        <div class="field">
            <label for="forgotEmail">Email <span class="req">*</span></label>
            <div class="input-wrap">
                <i class="bi bi-envelope lead"></i>
                <input class="a-input" id="forgotEmail" asp-for="Email" type="email" placeholder="ad.soyad@ornek.com" autocomplete="email" autofocus>
            </div>
        </div>
        <button type="submit" class="btn-primary-x">
            <span class="lbl">Yenileme Bağlantısı Gönder</span><i class="bi bi-send"></i>
        </button>
        <div class="form-foot">Şifrenizi hatırladınız mı? <a asp-controller="Login" asp-action="SignIn">Giriş Yap</a></div>
    </form>
}
