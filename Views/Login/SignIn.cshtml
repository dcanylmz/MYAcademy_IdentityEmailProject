@model UserLoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="form-head">
    <h1>Giriş Yap</h1>
    <p>Mailora hesabınıza giriş yapın ve mesajlarınıza kaldığınız yerden devam edin.</p>
    <div class="switch-link">Hesabınız yok mu? <a asp-controller="Register" asp-action="SignUp">Kayıt Ol</a></div>
</div>

<partial name="_AuthErrors" />

<form method="post" asp-controller="Login" asp-action="SignIn" asp-route-returnUrl="@ViewData["ReturnUrl"]" data-loading="Giriş yapılıyor…" novalidate>
    <div class="form-grid">
        <div class="field span-2">
            <label for="loginUser">Kullanıcı Adı veya Email <span class="req">*</span></label>
            <div class="input-wrap">
                <i class="bi bi-person lead"></i>
                <input class="a-input" id="loginUser" asp-for="Username" type="text" placeholder="kullaniciadi veya ad@ornek.com"
                       autocomplete="username" spellcheck="false" autocapitalize="none" autofocus>
            </div>
            <div class="msg" aria-live="polite"><span asp-validation-for="Username"></span></div>
        </div>

        <div class="field span-2">
            <label for="loginPassword">Şifre <span class="req">*</span></label>
            <div class="input-wrap">
                <i class="bi bi-lock lead"></i>
                <input class="a-input has-eye" id="loginPassword" asp-for="Password" type="password" placeholder="Şifreniz" autocomplete="current-password">
                <button type="button" class="eye-btn" data-eye="loginPassword" aria-label="Şifreyi göster" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
            </div>
            <div class="caps"><i class="bi bi-capslock"></i> Caps Lock açık</div>
            <div class="msg" aria-live="polite"><span asp-validation-for="Password"></span></div>
        </div>
    </div>

    <div class="row-between">
        <label><input type="checkbox" class="m-check" asp-for="RememberMe"> Beni hatırla</label>
        <a asp-controller="Login" asp-action="ForgotPassword">Şifremi unuttum</a>
    </div>

    <button type="submit" class="btn-primary-x">
        <span class="lbl">Giriş Yap</span><i class="bi bi-arrow-right"></i>
    </button>

    <div class="secure-note"><i class="bi bi-shield-check"></i> Hesabınız ASP.NET Core Identity ile korunur.</div>
    <div class="form-foot">Hesabınız yok mu? <a asp-controller="Register" asp-action="SignUp">Hemen kayıt olun</a></div>
</form>
