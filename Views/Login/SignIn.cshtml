@model UserLoginViewModel

@{
    Layout = null;
}
<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<title>Login Page</title>
<div class="container">
    <br />
    <br />
    <form method="post">
        <label>Kullanici Adiniz</label>
